{#
/**
 * @file
 * Tool page: "Who can help" — people to ask, the tool chat, the channel.
 *
 * Available variables:
 * - tool_label: the tool's title.
 * - people: list of {name, url, chips[], on_slack}.
 * - more_people: non-empty when people are badge sign-off people rather than
 *   people listed on the tool.
 * - channel / channel_url: the tool's Slack channel (no '#') and a link to it.
 * - ask_chat_url: the tool chat page; the button opens the chat on this page
 *   instead when it is there (tool-helpers.js). '' when the viewer turned AI
 *   off or cannot use the chat.
 * - ask_slack: TRUE when the chat's "Ask a person" posts in the channel.
 * - not_on_slack: TRUE when posting is on but the viewer has no Slack link.
 * - volunteer_form: "I can answer questions" toggle, or NULL.
 * - manage_url: staff link to the People to ask tab, or ''.
 */
#}
<section class="mh-tool-helpers" id="who-can-help" aria-labelledby="mh-tool-helpers-title">
  <h3 class="mh-tool-helpers__title" id="mh-tool-helpers-title">{{ 'Questions about this tool?'|t }}</h3>
  {% if people %}
    <p class="mh-tool-helpers__lead">
      {% if more_people %}
        {{ 'These people sign off this tool’s badge and can answer questions:'|t }}
      {% else %}
        {{ 'These people know this tool and are glad to answer questions:'|t }}
      {% endif %}
    </p>
    <ul class="mh-tool-helpers__people">
      {% for person in people %}
        <li class="mh-tool-helpers__person">
          <a href="{{ person.url }}" class="mh-tool-helpers__name">{{ person.name }}</a>
          {% for chip in person.chips %}<span class="mh-tool-helpers__chip">{{ chip }}</span>{% endfor %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="mh-tool-helpers__lead">{{ 'Nobody is listed for this tool yet.'|t }}</p>
  {% endif %}

  {% if ask_chat_url %}
    <p class="mh-tool-helpers__ask">
      <a href="{{ ask_chat_url }}" class="btn btn-primary mh-tool-helpers__ask-chat" data-mh-open-tool-chat>{{ 'Ask the tool assistant'|t }}</a>
    </p>
    <p class="mh-tool-helpers__fine">
      {% if ask_slack %}
        {% if people %}
          {{ 'It answers from the manual and earlier answers. If it can’t help, choose “Ask a person” in the chat’s ⋯ menu: your question is posted in #@channel and up to three of these people are tagged.'|t({'@channel': channel}) }}
        {% else %}
          {{ 'It answers from the manual and earlier answers. If it can’t help, choose “Ask a person” in the chat’s ⋯ menu to post your question in #@channel.'|t({'@channel': channel}) }}
        {% endif %}
      {% elseif channel %}
        {{ 'It answers from the manual and earlier answers.'|t }} <a href="{{ channel_url }}">{{ 'Or ask in #@channel on Slack'|t({'@channel': channel}) }}</a>.
      {% else %}
        {{ 'It answers from the manual and earlier answers.'|t }}
      {% endif %}
    </p>
  {% elseif channel %}
    <p class="mh-tool-helpers__channel">
      <a href="{{ channel_url }}">{{ 'Ask in #@channel on Slack'|t({'@channel': channel}) }}</a>
    </p>
  {% endif %}
  {% if not_on_slack %}
    <p class="mh-tool-helpers__fine">{{ 'We could not find you on MakeHaven’s Slack, so questions you send from here go to staff by email. To post in Slack yourself, join with the invite in your welcome email, using the same email address as your MakeHaven account.'|t }}</p>
  {% endif %}

  {% if volunteer_form or manage_url %}
    <div class="mh-tool-helpers__footer">
      {{ volunteer_form }}
      {% if manage_url %}<a href="{{ manage_url }}" class="mh-tool-helpers__manage">{{ 'Edit people to ask'|t }}</a>{% endif %}
    </div>
  {% endif %}
</section>
